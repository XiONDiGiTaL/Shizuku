<?xml version="1.0" encoding="utf-8"?>
<!-- Window backdrop: layered near-black with a soft blue bloom in the upper third. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xion_surface" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1F3F80FF"
                android:centerColor="#0A2F6BFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
