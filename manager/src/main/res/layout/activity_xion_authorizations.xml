<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xion_backdrop"
    android:orientation="vertical"
    android:paddingStart="@dimen/xion_gutter"
    android:paddingEnd="@dimen/xion_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/xion_action_reconnect"
            android:padding="8dp"
            android:src="@drawable/ic_x_back"
            android:tint="@color/xion_text" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/xion_auth_title"
            android:textAppearance="@style/TextAppearance.Xion.Display"
            android:textSize="28sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReload"
            style="@style/Widget.Xion.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reload"
            android:textSize="12sp"
            app:icon="@drawable/ic_x_restart"
            app:iconSize="16dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Xion.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/grantedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="n/a"
                    android:textAppearance="@style/TextAppearance.Xion.Metric"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/grantedLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xion_auth_granted"
                        android:textAppearance="@style/TextAppearance.Xion.Title"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/grantedSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/diagToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/xion_chip_neutral"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/xion_auth_diag"
                    android:textColor="@color/xion_text_body"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Xion.Mono"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/xion_auth_empty"
        android:textAppearance="@style/TextAppearance.Xion.Body"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none" />
</LinearLayout>
