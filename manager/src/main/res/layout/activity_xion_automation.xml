<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xion_backdrop"
    android:orientation="vertical"
    android:paddingStart="@dimen/xion_gutter"
    android:paddingEnd="@dimen/xion_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_x_back"
            android:tint="@color/xion_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/xion_auto_title"
            android:textAppearance="@style/TextAppearance.Xion.Display"
            android:textSize="26sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Xion.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTH TOKEN"
                android:textAppearance="@style/TextAppearance.Xion.Overline" />

            <TextView
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Xion.Mono"
                android:textColor="@color/xion_brand_hi"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Control intents must include this token as the &quot;auth&quot; extra, exactly as the classic Shizuku intents do."
                android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyToken"
                style="@style/Widget.Xion.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/xion_auto_copy"
                android:textSize="11sp"
                app:icon="@drawable/ic_x_copy"
                app:iconSize="15dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
