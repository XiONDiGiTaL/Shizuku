<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:fitsSystemWindows="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xion_backdrop"
    android:orientation="vertical"
    android:paddingStart="@dimen/xion_gutter"
    android:paddingEnd="@dimen/xion_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_x_back"
            android:tint="@color/xion_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/xion_snapshots_title"
            android:textAppearance="@style/TextAppearance.Xion.Display"
            android:textSize="25sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNew"
            style="@style/Widget.Xion.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xion_snapshots_new"
            android:textSize="11sp"
            app:icon="@drawable/ic_x_clock"
            app:iconSize="15dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/xion_snapshots_note"
        android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/snapshotList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/xion_snapshots_footer_ops"
        android:textAppearance="@style/TextAppearance.Xion.Body.Muted"
        android:textSize="10sp" />
</LinearLayout>
