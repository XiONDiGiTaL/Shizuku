<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xion_backdrop"
    android:orientation="vertical"
    android:paddingStart="@dimen/xion_gutter"
    android:paddingEnd="@dimen/xion_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/xion_wireless_title"
            android:padding="8dp"
            android:src="@drawable/ic_x_back"
            android:tint="@color/xion_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/xion_wireless_title"
            android:textAppearance="@style/TextAppearance.Xion.Display"
            android:textSize="28sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/xion_wireless_lede"
                android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />

            <!-- Live state -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Xion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xion_wireless_connection"
                        android:textAppearance="@style/TextAppearance.Xion.Overline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/xion_wireless_row_wireless"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />

                        <TextView
                            android:id="@+id/valueWireless"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xion_metric_unknown"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/xion_wireless_row_usb"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />

                        <TextView
                            android:id="@+id/valueUsb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xion_metric_unknown"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/xion_wireless_row_service"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />

                        <TextView
                            android:id="@+id/valueService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xion_metric_unknown"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/xion_wireless_row_port"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />

                        <TextView
                            android:id="@+id/valuePort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/xion_metric_unknown"
                            android:textAppearance="@style/TextAppearance.Xion.Body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pair -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Xion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xion_wireless_pair_title"
                        android:textAppearance="@style/TextAppearance.Xion.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/xion_wireless_pair_body"
                        android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPair"
                        style="@style/Widget.Xion.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/xion_wireless_pair_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDevOptions"
                        style="@style/Widget.Xion.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/xion_wireless_dev_options" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Start -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Xion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xion_wireless_start_title"
                        android:textAppearance="@style/TextAppearance.Xion.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/xion_wireless_start_body"
                        android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartWireless"
                        style="@style/Widget.Xion.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/xion_wireless_start_button" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TCP mode -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Xion.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xion_wireless_tcp_title"
                        android:textAppearance="@style/TextAppearance.Xion.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tcpBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTcpMode"
                        style="@style/Widget.Xion.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/xion_wireless_note"
                android:textAppearance="@style/TextAppearance.Xion.Body.Muted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
