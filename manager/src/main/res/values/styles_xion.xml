<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Typography -->
    <style name="TextAppearance.Xion.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/xion_text_muted</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Xion.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/xion_text</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="TextAppearance.Xion.Serif" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/xion_brand_hi</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.Xion.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/xion_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Xion.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/xion_text_body</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Xion.Body.Muted" parent="TextAppearance.Xion.Body">
        <item name="android:textColor">@color/xion_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Xion.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/xion_text_body</item>
    </style>

    <style name="TextAppearance.Xion.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/xion_text</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Surfaces -->
    <style name="Widget.Xion.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/xion_surface_raised</item>
        <item name="cardCornerRadius">@dimen/xion_radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/xion_hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/xion_brand_soft</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Xion.Card.Interactive" parent="Widget.Xion.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Buttons: fully rounded, no all-caps, clear pressed feedback -->
    <style name="Widget.Xion.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/xion_radius_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Xion.Button.Primary" parent="Widget.Xion.Button">
        <item name="backgroundTint">@color/xion_brand</item>
        <item name="android:textColor">@color/xion_on_accent</item>
        <item name="iconTint">@color/xion_on_accent</item>
    </style>

    <style name="Widget.Xion.Button.Secondary" parent="Widget.Xion.Button">
        <item name="backgroundTint">@color/xion_brand_soft</item>
        <item name="android:textColor">@color/xion_brand_hi</item>
        <item name="iconTint">@color/xion_brand_hi</item>
        <item name="strokeColor">@color/xion_hairline_strong</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Xion.Button.Ghost" parent="Widget.Xion.Button">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/xion_text_body</item>
        <item name="iconTint">@color/xion_text_body</item>
        <item name="strokeColor">@color/xion_hairline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Xion.Button.Danger" parent="Widget.Xion.Button">
        <item name="backgroundTint">@color/xion_negative_soft</item>
        <item name="android:textColor">@color/xion_negative</item>
        <item name="iconTint">@color/xion_negative</item>
        <item name="strokeColor">@color/xion_negative</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Xion.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/xion_radius_pill</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Xion.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/xion_hairline</item>
    </style>

</resources>
